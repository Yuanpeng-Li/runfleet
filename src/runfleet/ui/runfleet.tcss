/* RunFleet: k9s × lazygit × nvitop. Dense, dark, transparent where the terminal allows. */

Screen {
    background: ansi_default;
    color: ansi_default;     /* body text in the terminal's own foreground: readable on light and dark profiles */
    layers: base overlay;
}

/* Colours: $rf-* are solid colours mixed from the terminal's real background (theme.configure). Never `$x N%` on a
   transparent (ansi_default) background: Textual blends it against black, whatever the terminal shows (§7.11).
   Clickable chips keep their own colours: FleetHeader, HintBar and ViewTabs override Widget.link_style. */

/* ---- main screen ---------------------------------------------------------------------- */
#header, FleetHeader { background: $rf-panel; color: $rf-foreground; }
#tabs { background: ansi_default; }
#hints, HintBar { background: $rf-panel; color: $rf-foreground; dock: bottom; }
App.-settings-open HintBar { visibility: hidden; }   /* the Settings panel has its own hint line */
#views { height: 1fr; }

/* ---- fleet cards ---------------------------------------------------------------------- */
#fleet-cards { height: 1fr; scrollbar-size-vertical: 1; scrollbar-gutter: stable; }   /* card widths never jump */
#fleet-grid { grid-size: 2; grid-rows: auto; grid-gutter: 0 0; height: auto; padding: 0 0; }
HostCard {
    border: solid $rf-border;
    border-title-color: $rf-foreground;
    border-title-align: left;
    padding: 0 1;
    height: auto;
    background: ansi_default;
    text-wrap: nowrap;          /* a line wider than the card is cut with an ellipsis, never wrapped */
    text-overflow: ellipsis;
}
HostCard:focus { border: heavy $accent; background: $rf-hover; }
HostCard.-scoped { border: solid $accent; }
HostCard.-scoped:focus { border: heavy $accent; }
HostCard.-problem { border: solid $rf-border-problem; }
HostCard.-problem:focus { border: heavy $error; }
HostCard.-stale { color: $rf-muted; }
FleetPanel {                /* roomy Fleet view: free GPUs by type + what changed (not a card: never focused) */
    border: solid $rf-rule;
    border-title-color: $rf-muted;
    border-title-align: left;
    padding: 0 1;
    background: ansi_default;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ---- tables --------------------------------------------------------------------------- */
DataTable {
    background: ansi_default;
    color: ansi_default;     /* the terminal's own foreground (Textual's default is the theme's) */
    scrollbar-size-vertical: 1;
    height: 1fr;
}
DataTable > .datatable--header { background: ansi_default; color: $rf-muted; text-style: bold; }
DataTable > .datatable--cursor { background: $rf-cursor; color: ansi_default; text-style: none; }
DataTable:blur > .datatable--cursor { background: $rf-cursor-blur; }
/* NO_COLOR strips backgrounds, and ansi / 16 colours have no tint to spare: the cursor row needs an attribute */
.-no-color DataTable > .datatable--cursor, .-plain-cursor DataTable > .datatable--cursor { text-style: reverse; }
.-no-color DataTable:blur > .datatable--cursor, .-plain-cursor DataTable:blur > .datatable--cursor {
    text-style: underline;
}
DataTable > .datatable--hover { background: $rf-hover; }
DataTable > .datatable--header-hover { background: $rf-hover; }

/* ---- jobs view ------------------------------------------------------------------------ */
#jobs-body { height: 1fr; layout: vertical; }
JobsView.-side #jobs-body { layout: horizontal; }
JobsView.-side #jobs-table { width: 62%; }
JobsView.-side #preview { width: 1fr; height: 1fr; border-left: solid $rf-border; padding: 0 1; }
#preview { height: 8; background: ansi_default; }
FilterBar { background: $rf-hover; }

/* ---- detail screens ------------------------------------------------------------------- */
.box {
    border: solid $rf-border;
    border-title-align: left;
    border-title-color: $rf-foreground;
    padding: 0 1;
    height: auto;
    background: ansi_default;
}
.box:focus-within { border: solid $accent; }
#gpu-panel { border-subtitle-color: $rf-muted; }   /* "click a GPU …": readable on an unfocused box */
.title-line { height: 1; padding: 0 1; }
.note { color: $rf-muted; height: auto; padding: 0 1; }

TabbedContent { height: 1fr; }
TabbedContent ContentSwitcher { height: 1fr; }
TabPane { padding: 0; }
Tabs { height: 2; }
Tabs Tab { text-style: none; color: $rf-muted; }            /* not faint (SGR 2): iTerm2 draws it half-transparent */
Tabs Tab.-active { text-style: bold; color: $rf-foreground; }
Tabs:focus Tab.-active { color: $rf-surface; background: $accent; }   /* Textual paints the accent behind it */
/* ansi / 16 colours: "default on blue" is the terminal's foreground on its blue (unreadable on some profiles); reverse
   video draws the terminal's own background on the accent instead */
.-plain-cursor Tabs:focus Tab.-active { color: $accent; background: ansi_default; text-style: bold reverse; }

/* ---- modals --------------------------------------------------------------------------- */
ModalScreen { background: transparent; align: center middle; }   /* no backdrop: a tint would be blended on black */
.dialog {
    border: solid $accent;
    border-title-align: left;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-align: right;
    border-subtitle-color: $rf-muted;
    background: $rf-surface;
    color: $rf-foreground;   /* explicit surface: explicit theme foreground, whatever the terminal's */
    padding: 0 1;
    width: 80;
    max-width: 96%;
    height: auto;
    max-height: 90%;
}
#help-box { width: 116; }
#confirm-box { width: 78; }
#menu-box { width: 66; }
#menu, #menu:focus { border: none; background: transparent; padding: 0; height: auto; max-height: 16; }
#err-box, #log-box { width: 100; }
#doctor-box, #manual-box { width: 92; }
#ls-box { width: 120; }                      /* = log_search.BOX_W */
#ls-prompt-box { width: 100; }
#fl-box { width: 104; }                      /* = found_logs.BOX_W */
.dialog-buttons { height: auto; align-horizontal: right; padding-top: 1; }
/* menus in dialogs (action menu, digest, forwards): the highlighted option on the cursor tint, not the accent — the
   prompts keep their own colours (dim, orange, muted), which sit at 1.0-1.6:1 on the accent */
.dialog OptionList > .option-list--option-highlighted, .dialog OptionList:focus > .option-list--option-highlighted {
    color: $rf-foreground;
    background: $rf-cursor;
}
.-plain-cursor .dialog OptionList > .option-list--option-highlighted,
.-no-color .dialog OptionList > .option-list--option-highlighted { text-style: reverse; }
.dialog-buttons Button { margin-left: 2; }

/* ---- notifications -------------------------------------------------------------------- */
Toast { max-width: 70; }

/* ---- job detail ----------------------------------------------------------------------- */
#summary-top { height: auto; }
#summary-top > #job-box { width: 1fr; height: auto; min-height: 10; }
#summary-top > #right-col { width: 1fr; height: auto; }
#right-col > .box { width: 1fr; }
#summary-log { height: 1fr; min-height: 6; }
#summary-compact { height: auto; }
JobDetailScreen.-compact #summary-top { display: none; }
#steps-table { height: auto; max-height: 14; }
#why { height: auto; }
#raw-text { padding: 0 1; }

/* ---- host detail ---------------------------------------------------------------------- */
#ws-layout, #cluster-layout { height: 1fr; }
#procs-box, #nodes-box { height: 1fr; min-height: 5; }
#parts-box { height: auto; }
#parts-box > PartitionTable { height: auto; max-height: 8; }
#host-box, #ws-conn, #myjobs-box, #caps-box, #onnode-box { height: auto; }
#banner { color: $warning; }
#myjobs-box, #caps-box { text-wrap: wrap; }

/* ---- shared: never wrap box content (lines are pre-fitted; overflow ends in …), subtle scrollbars ---- */
.box { text-wrap: nowrap; text-overflow: ellipsis; }
DataTable, RichLog, VerticalScroll {
    scrollbar-size-horizontal: 1;
    scrollbar-color: $rf-scrollbar;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
    scrollbar-background: $rf-panel;
    scrollbar-background-hover: $rf-panel;
    scrollbar-background-active: $rf-panel;
    scrollbar-corner-color: $rf-panel;
}
PartitionTable, NodeTable, ProcTable, #steps-table { overflow-x: hidden; }
JobDetailScreen.-narrow #summary-top { layout: vertical; }
JobDetailScreen.-narrow #summary-top > #job-box, JobDetailScreen.-narrow #summary-top > #right-col { width: 1fr; }
